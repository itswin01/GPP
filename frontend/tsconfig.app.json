{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* "@/..." resolves to src/ — matches the shadcn convention.
       baseUrl is omitted: TS 7 deprecates it, and paths resolve relative to
       this file without it. Vite has the matching alias in vite.config.ts. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting. noUnusedLocals is relaxed: the 3D hero declares shader
       uniforms and geometry params that TS cannot see are consumed. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
